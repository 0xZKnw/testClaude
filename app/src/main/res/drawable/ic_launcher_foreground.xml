<?xml version="1.0" encoding="utf-8"?>
<!--
  Three fanned cards with the four-colour wheel of a Wild on the front one. Same ink
  keyline, same warm-white stock and the same four colours as the cards in the game, so
  the icon and the table read as one thing.

  Everything that carries meaning stays inside the adaptive-icon safe zone — a circle of
  radius 33 around the centre — because a round launcher mask crops the rest away. Only
  the outer corners of the two fanned cards reach past it, and losing those costs
  nothing.

  Card frames are all the same 34x52 rounded rect at x37,y28: ink, then stock, then the
  colour, exactly like UnoCardFace draws them on screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fanned left: red -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-20">
        <path
            android:fillColor="#FF14161D"
            android:pathData="M42,28 h24 a5,5 0 0 1 5,5 v42 a5,5 0 0 1 -5,5 h-24 a5,5 0 0 1 -5,-5 v-42 a5,5 0 0 1 5,-5 z" />
        <path
            android:fillColor="#FFFDFBF4"
            android:pathData="M42.5,29.5 h23 a4,4 0 0 1 4,4 v41 a4,4 0 0 1 -4,4 h-23 a4,4 0 0 1 -4,-4 v-41 a4,4 0 0 1 4,-4 z" />
        <path
            android:fillColor="#FFF23B2E"
            android:pathData="M44.5,32.5 h19 a3,3 0 0 1 3,3 v37 a3,3 0 0 1 -3,3 h-19 a3,3 0 0 1 -3,-3 v-37 a3,3 0 0 1 3,-3 z" />
    </group>

    <!-- Fanned right: blue -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="20">
        <path
            android:fillColor="#FF14161D"
            android:pathData="M42,28 h24 a5,5 0 0 1 5,5 v42 a5,5 0 0 1 -5,5 h-24 a5,5 0 0 1 -5,-5 v-42 a5,5 0 0 1 5,-5 z" />
        <path
            android:fillColor="#FFFDFBF4"
            android:pathData="M42.5,29.5 h23 a4,4 0 0 1 4,4 v41 a4,4 0 0 1 -4,4 h-23 a4,4 0 0 1 -4,-4 v-41 a4,4 0 0 1 4,-4 z" />
        <path
            android:fillColor="#FF2E9CF2"
            android:pathData="M44.5,32.5 h19 a3,3 0 0 1 3,3 v37 a3,3 0 0 1 -3,3 h-19 a3,3 0 0 1 -3,-3 v-37 a3,3 0 0 1 3,-3 z" />
    </group>

    <!-- Front and upright: the Wild -->
    <path
        android:fillColor="#FF14161D"
        android:pathData="M42,28 h24 a5,5 0 0 1 5,5 v42 a5,5 0 0 1 -5,5 h-24 a5,5 0 0 1 -5,-5 v-42 a5,5 0 0 1 5,-5 z" />
    <path
        android:fillColor="#FFFDFBF4"
        android:pathData="M42.5,29.5 h23 a4,4 0 0 1 4,4 v41 a4,4 0 0 1 -4,4 h-23 a4,4 0 0 1 -4,-4 v-41 a4,4 0 0 1 4,-4 z" />
    <path
        android:fillColor="#FF262C39"
        android:pathData="M44.5,32.5 h19 a3,3 0 0 1 3,3 v37 a3,3 0 0 1 -3,3 h-19 a3,3 0 0 1 -3,-3 v-37 a3,3 0 0 1 3,-3 z" />

    <!-- Ink disc, so the wheel keeps a keyline like every other symbol -->
    <path
        android:fillColor="#FF14161D"
        android:pathData="M54,42.5 a11.5,11.5 0 1,0 0.01,0 z" />

    <!-- The four quadrants, clockwise from the top left -->
    <path
        android:fillColor="#FFF23B2E"
        android:pathData="M54,54 L44,54 A10,10 0 0 1 54,44 Z" />
    <path
        android:fillColor="#FFFFC21A"
        android:pathData="M54,54 L54,44 A10,10 0 0 1 64,54 Z" />
    <path
        android:fillColor="#FF41C258"
        android:pathData="M54,54 L64,54 A10,10 0 0 1 54,64 Z" />
    <path
        android:fillColor="#FF2E9CF2"
        android:pathData="M54,54 L54,64 A10,10 0 0 1 44,54 Z" />

    <!-- Ink spokes between the quadrants -->
    <path
        android:fillColor="#FF14161D"
        android:pathData="M44,52.9 h20 v2.2 h-20 z" />
    <path
        android:fillColor="#FF14161D"
        android:pathData="M52.9,44 h2.2 v20 h-2.2 z" />
</vector>
